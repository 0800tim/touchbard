def btn(icon=None, label=None, w=84, **kw):
    item = {"kind": "button", "w": w}
    if icon:
        item["icon"] = icon
    if label:
        item["label"] = label
    item.update(kw)
    return item


def cmd(icon, command, w=84, **kw):
    return btn(icon, w=w, act={"cmd": command}, **kw)


def key(k, label=None, icon=None, w=None, **kw):
    item = btn(icon, label, w=w, act={"key": k if isinstance(k, list) else [k]}, **kw)
    if w is None:
        item.pop("w")
    return item


