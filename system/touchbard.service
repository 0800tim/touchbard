[Unit]
Description=Themed Touch Bar daemon (Omarchy)
Documentation=file:///usr/local/share/touchbar/README.md
# Same triggers as tiny-dfr: the device aliases come from tiny-dfr's udev rules,
# and it must take the panel before Hyprland starts.
After=systemd-user-sessions.service getty@tty1.service plymouth-quit.service systemd-logind.service dev-tiny_dfr_display.device dev-tiny_dfr_backlight.device dev-tiny_dfr_display_backlight.device
BindsTo=dev-tiny_dfr_display.device dev-tiny_dfr_backlight.device
Conflicts=tiny-dfr.service

[Service]
ExecStart=/usr/local/bin/touchbard
Restart=always
RestartSec=1
RuntimeDirectory=touchbard
RuntimeDirectoryMode=0755
StateDirectory=touchbard

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
